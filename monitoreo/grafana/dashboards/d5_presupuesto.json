{
 "uid": "expedientes-presupuesto",
 "title": "D5 - Presupuesto de error y alertas",
 "description": "SLO, burn rate y alertas activas",
 "tags": [
  "expedientes"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5s",
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "panels": [
  {
   "id": 31,
   "type": "stat",
   "title": "Presupuesto de error restante",
   "description": "SLO 99 % de peticiones sin error 5xx; ventana de demo de 10 min (en produccion, 30 dias)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "clamp_min(1 - ((sum(rate(expedientes_http_requests_total{codigo=~\"5..\"}[10m])) or vector(0)) / clamp_min(sum(rate(expedientes_http_requests_total[10m])), 0.001)) / 0.01, 0)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.25
       },
       {
        "color": "green",
        "value": 0.5
       }
      ]
     },
     "mappings": [],
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value"
   }
  },
  {
   "id": 32,
   "type": "stat",
   "title": "Consumo del presupuesto (burn rate)",
   "description": "1x = se consume justo al ritmo permitido; 14,4x dispara la alerta rapida",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 5
   },
   "targets": [
    {
     "refId": "A",
     "expr": "((sum(rate(expedientes_http_requests_total{codigo=~\"5..\"}[2m])) or vector(0)) / clamp_min(sum(rate(expedientes_http_requests_total[2m])), 0.001)) / 0.01",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "x",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 6
       },
       {
        "color": "red",
        "value": 14.4
       }
      ]
     },
     "mappings": [],
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value"
   }
  },

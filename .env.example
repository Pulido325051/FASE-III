# OPCIONAL: sin este archivo se usan contrasenas por defecto de prueba.
# Copialo como .env solo si quieres cambiarlas.
# Son SOLO para la base de datos de PRUEBA con datos ficticios. No uses aqui
# contrasenas reales de la base de Control Escolar.
DB_ROOT_PASSWORD=cambia-esta-root-2026
DB_USER=clasificador
DB_PASSWORD=cambia-esta-2026
# Si el puerto 8000 o 3307 de tu PC ya esta ocupado, cambialos aqui:
API_PUERTO=8000
DB_PUERTO=3307
# Usuarios de la pagina (uno por rol). Estos valores son las contrasenas de DEMO que ya trae docker-compose:
#   administrador -> todo, incluidos los respaldos
#   operador      -> todo, menos los respaldos
#   consultor     -> solo consultar expedientes y ver archivos
# Cambialas si el sistema se publica en una red o en internet. Puede ser la contrasena tal cual o el hash
# "pbkdf2_sha256$..." de config.ini del programa de escritorio (entre comillas simples).
CLAVE_ADMINISTRADOR=admin-2026
CLAVE_OPERADOR=operador-2026
CLAVE_CONSULTOR=consultor-2026
